import agenciaDeViajes.*

describe "Test de agencia de viajes"{

    const pepe = new Coordinador(motivado = true, rol = "Guia", viajesRealizados = 22, aniosExperiencia = 2)   
    const trasladosPrivados = new BeneficioEspecial(tipo = "Traslados Privados", costo = 10000, estaVigente = false)
    const segurosAdicionales = new BeneficioEspecial(tipo = "Seguros Adicionales", costo = 200, estaVigente = false)
    const packNacional = new PackNacional(provinciaDestino = "Jujuy", duracion = 2, precioBase = 3000, beneficiosEspeciales = [trasladosPrivados, segurosAdicionales], coordinador = pepe)
    const packInternacional = new PackInternacional(paisDestino = "Francia", duracion = 5, precioBase = 7000, beneficiosEspeciales = [trasladosPrivados, segurosAdicionales], coordinador = pepe)
    const packProvincial = new PackProvincial(provinciaDestino = "Jujuy", duracion = 2, precioBase = 5000, beneficiosEspeciales = [trasladosPrivados, segurosAdicionales], coordinador = pepe, cantidadDeCiudades = 6)

    test "Un pack nacional sin beneficios vigentes devuelve el precio base en el precio final"{
        assert.equals(packNacional.precioFinal(), 3000)
    }
    test "Un pack nacional suma correctamente 2 beneficios vigentes al precio final"{
        assert.equals(packNacional.precioFinal(), 13200)
    }
    test "Un pack internacional sin beneficios vigentes devuelve el precio base mas 20% como final"{
        assert.equals(packInternacional.precioFinal(), 8400)
    }
    test "Es altamente calificado un guia motivado"{
        assert.that(pepe.rol == "Guia")
        assert.that(pepe.motivado)
        assert.equals(pepe.viajes() > 20)
        assert.that(pepe.esCalificado())
    }
    test "Un asistente logistico con menos de 3 años de experiencia no es calificado"{
        assert.that(pepe.rol == "Asistente logístico")
        assert.that(pepe.experiencia() < 3)
        assert.notThat(pepe.esCalificado())
    }
    test "Un acompañante con cualquier cantidad de viajes es siempre calificado si supera los 20"{
        assert.that(pepe.rol == "Acompaniante")
        assert.that(pepe.viajes() > 20)
        assert.that(pepe.esCalificado())
    }
    test "Pack nacional es premium"{
        assert.that(packNacional.esPremium())
    } 
    test "Pack internacional es premium"{
        assert.that(packInternacional.esPremium())
    }
    test "Pack provincial no es premium"{
        assert.notThat(packProvincial.esPremium())
    }
}